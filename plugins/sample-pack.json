{
  "manifest_version": "1.0",
  "plugin_id": "castex.official.starter",
  "name": "Castex Starter & Fandub Pack",
  "author": "Castex Community",
  "description": "Default remote catalog and verified community fandub sync routes.",
  "supported_types": ["anime", "movie", "series"],
  "stremio_addons": [
    "https://v3-cinemeta.strem.io/manifest.json"
  ],
  "hybrid_dub_routes": [
    {
      "content_id": "tt0000000",
      "title": "Sample Anime / Movie",
