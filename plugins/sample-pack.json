      "episode": 1,
      "dub_language": "Hindi (Fandub)",
      "creator_name": "Indie Dubber",
      "source_type": "youtube_embed",
      "external_url": "https://www.youtube.com/watch?v=VIDEO_ID",
      "audio_offset_ms": 0
    }
  ]
}
